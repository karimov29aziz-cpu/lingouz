# Скопируйте этот файл под именем .env, раскомментируйте ОДИН вариант и перезапустите server.js.
# Файл .env никому не показывайте.

# Вариант 1. Ollama: бесплатно, без ключей, работает на вашем компьютере.
# Установите Ollama с https://ollama.com и выполните: ollama pull llama3.2
# AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# Вариант 2. Бесплатный облачный сервис с ключом, например Groq (https://console.groq.com, карта не нужна).
# Создайте API-ключ и выберите модель из списка в консоли Groq.
# AI_PROVIDER=openai
# 

# 

# Вариант 3. Claude через Anthropic API (платный ключ с https://console.anthropic.com).
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# PORT=3000
